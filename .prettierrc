{
  "plugins": [
    "@prettier/plugin-php",
    "prettier-plugin-blade",
    "prettier-plugin-tailwindcss"
  ],
  "overrides": [
    {
      "files": "*.php",
      "excludeFiles": "*.blade.php",
      "options": { "parser": "php", "tabWidth": 4, "printWidth": 120 }
    },
    {
      "files": "*.blade.php",
      "options": {
        "parser": "blade",
        "tabWidth": 2,
        "sortTailwindcssClasses": true,
        "wrapAttributes": "auto",
        "wrapLineLength": 120
      }
    }
  ]
}