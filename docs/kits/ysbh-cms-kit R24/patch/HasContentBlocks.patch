+    /**
+     * Tambal $data dengan nilai dari $defaults HANYA untuk kunci yang belum ada.
+     * Hanya array asosiatif (mis. peta bahasa {id,en}) yang ditelusuri lebih
+     * dalam; daftar (list) dibiarkan apa adanya.
+     */
+    protected function fillDefaults(array $defaults, array $data): array
+    {
+        foreach ($defaults as $key => $default) {
+            if (!array_key_exists($key, $data)) {
+                $data[$key] = $default;
+            } elseif (is_array($default) && is_array($data[$key]) && $this->isAssocArray($default)) {
+                $data[$key] = $this->fillDefaults($default, $data[$key]);
+            }
+        }
+        return $data;
+    }
